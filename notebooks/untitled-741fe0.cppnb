      "id": "cell-8cc7802c-2174-4441-b030-8665da9a7d81",
      "type": "code",
      "source": "#include <iostream>\r\n\r\nint main() {\r\n    int myNumber;\r\n     int myNumber2;\r\n    \r\n\r\n    // Ask the user for input\r\n    std::cout << \"Enter a number: \";\r\n\r\n    // Take the input and save it in myNumber\r\n    std::cin >> myNumber;\r\n     std::cin >> myNumber2;\r\n\r\n    // Print the number back to the screen\r\n    std::cout << \"You entered: \" << myNumber << std::endl;\r\n\r\n    return 0;\r\n}\r\n",
      "outputs": [
