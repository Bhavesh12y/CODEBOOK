    {
      "id": "cell-fa507ed9-2d82-455c-b663-dd10dad59063",
      "type": "code",
      "source": "#include <iostream>\r\n#include <string>\r\n#include <vector>\r\n\r\nnamespace Math {\r\n\r\n    int add(int a, int b) {\r\n        return a + b;\r\n    }\r\n\r\n    int square(int x) {\r\n        return x * x;\r\n    }\r\n\r\n    namespace Advanced {\r\n\r\n        int cube(int x) {\r\n            return x * x * x;\r\n        }\r\n\r\n    }\r\n}\r\n\r\nnamespace App {\r\n\r\n    std::string name = \"CppBook\";\r\n\r\n    int version = 17;\r\n\r\n    namespace Config {\r\n\r\n        bool enabled = true;\r\n\r\n    }\r\n\r\n    void printInfo() {\r\n        std::cout << name << \" \" << version << \"\\n\";\r\n    }\r\n}\r\n\r\nnamespace Data {\r\n\r\n    struct Student {\r\n        std::string name;\r\n        int age;\r\n\r\n        void print() const {\r\n            std::cout << name << \" \" << age << \"\\n\";\r\n        }\r\n    };\r\n\r\n    std::vector<int> values = {10, 20, 30};\r\n\r\n    int sum() {\r\n        int total = 0;\r\n\r\n        for (int x : values) {\r\n            total += x;\r\n        }\r\n\r\n        return total;\r\n    }\r\n}\r\n\r\n// Namespace alias\r\nnamespace M = Math;\r\n\r\n// using-declarations\r\nusing Math::add;\r\nusing Math::square;\r\nusing Data::Student;\r\n\r\n// using namespace\r\nusing namespace App::Config;\r\n\r\nint main() {\r\n\r\n    std::cout << \"=== BASIC NAMESPACE ===\\n\";\r\n\r\n    std::cout << Math::add(10, 20) << \"\\n\";\r\n    std::cout << Math::square(5) << \"\\n\";\r\n\r\n    std::cout << \"=== NESTED NAMESPACE ===\\n\";\r\n\r\n    std::cout << Math::Advanced::cube(3) << \"\\n\";\r\n\r\n    std::cout << \"=== NAMESPACE ALIAS ===\\n\";\r\n\r\n    std::cout << M::add(7, 8) << \"\\n\";\r\n    std::cout << M::square(6) << \"\\n\";\r\n\r\n    std::cout << \"=== APP NAMESPACE ===\\n\";\r\n\r\n    App::printInfo();\r\n\r\n    std::cout << App::name << \"\\n\";\r\n    std::cout << App::version << \"\\n\";\r\n\r\n    std::cout << \"=== USING DECLARATION ===\\n\";\r\n\r\n    std::cout << add(2, 3) << \"\\n\";\r\n    std::cout << square(4) << \"\\n\";\r\n\r\n    std::cout << \"=== USING NAMESPACE ===\\n\";\r\n\r\n    std::cout << std::boolalpha << enabled << \"\\n\";\r\n\r\n    std::cout << \"=== STRUCT INSIDE NAMESPACE ===\\n\";\r\n\r\n    Student s{\"Bhavesh\", 20};\r\n    s.print();\r\n\r\n    std::cout << \"=== NAMESPACE DATA ===\\n\";\r\n\r\n    std::cout << Data::values.size() << \"\\n\";\r\n    std::cout << Data::sum() << \"\\n\";\r\n\r\n    std::cout << \"=== MODIFY NAMESPACE STATE ===\\n\";\r\n\r\n    Data::values.push_back(40);\r\n\r\n    std::cout << Data::sum() << \"\\n\";\r\n\r\n    std::cout << \"=== FINAL ===\\n\";\r\n\r\n    std::cout << \"NAMESPACE_TEST_PASS\\n\";\r\n\r\n    return 0;\r\n}",
      "outputs": [
