    {
      "id": "cell-ed7dcd39-4bc4-420d-bf9e-684ef04e9ab6",
      "type": "code",
      "source": "#include <iostream>\r\n#include <vector>\r\n\r\nusing namespace std;\r\n\r\n\r\n    vector<int> numbers;\r\n    int quantity;\r\n\r\n    // Ask the user exactly how many items to enter\r\n    cout << \"How many numbers do you want to input? \";\r\n    if (!(cin >> quantity) || quantity <= 0) {\r\n        cout << \"Invalid quantity.\" << endl;\r\n        return 1;\r\n    }\r\n\r\n    // Input loop: Collect exactly the requested amount of numbers\r\n    cout << \"Enter your \" << quantity << \" numbers (e.g., 2 3): \";\r\n    for (int i = 0; i < quantity; ++i) {\r\n        int val;\r\n        cin >> val;\r\n        numbers.push_back(val);\r\n    }\r\n\r\n    cout << \"\\n--- Loop Output Phase ---\" << endl;\r\n\r\n    // Output loop: The single loop displaying the results\r\n    int total_sum = 0;\r\n    for (int num : numbers) {\r\n        cout << \"Processed Value: \" << num << endl;\r\n        total_sum += num;\r\n    }\r\n\r\n    cout << \"Final Sum: \" << total_sum << endl;\r\n    return 0;\r\n\r\n",
