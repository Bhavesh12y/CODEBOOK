      "id": "cell-6796584a-1c44-46eb-8291-daf4cace6c5a",
      "type": "code",
      "source": "#include <iostream>\n\nint main() {\n    int num1, num2;\n    \n    // Prompt the user for input\n    std::cout << \"Enter two numbers (e.g., 2 3): \";\n    \n    // Read the two inputs from the console\n    if (std::cin >> num1 >> num2) {\n        // Perform basic arithmetic to verify the compiler works\n        int sum = num1 + num2;\n        int diff = num1 - num2;\n        \n        // Output the results\n        std::cout << \"\\n--- Compiler Check Results ---\" << std::endl;\n        std::cout << \"First Number: \" << num1 << std::endl;\n        std::cout << \"Second Number: \" << num2 << std::endl;\n        std::cout << \"Sum (num1 + num2): \" << sum << std::endl;\n        std::cout << \"Difference (num1 - num2): \" << diff << std::endl;\n        std::cout << \"-------------------------------\" << std::endl;\n        std::cout << \"Success: Your C++ compiler is working perfectly!\" << std::endl;\n    } else {\n        std::cout << \"Error: Invalid input provided.\" << std::endl;\n    }\n\n    return 0;\n}\n",
      "outputs": [
        {
          "type": "stdout",
          "text": "Enter two numbers (e.g., 2 3): \n--- Compiler Check Results ---\nFirst Number: 2\nSecond Number: 3\nSum (num1 + num2): 5\nDifference (num1 - num2): -1\n-------------------------------\nSuccess: Your C++ compiler is working perfectly!\n",
          "diagnostics": []
        }
      ],
      "executionCount": 2,
      "status": "success",
      "executionTime": 0.4985
    },
    {
      "id": "cell-71e5fed4-00f9-42ae-a8f0-2fc4799e046b",
      "type": "code",
      "source": "#include <iostream>\r\n#include <vector>\r\n\r\nint main() {\r\n    // Create a vector to store the integers\r\n    std::vector<int> numbers;\r\n    int input_val;\r\n\r\n    std::cout << \"Enter 2 or 3 integers (press Ctrl+D or type a non-number to finish):\\n\";\r\n\r\n    // Loop to read inputs continuously until EOF or invalid input\r\n    while (std::cin >> input_val) {\r\n        numbers.push_back(input_val);\r\n    }\r\n\r\n    // Verify if we actually received any data\r\n    if (numbers.empty()) {\r\n        std::cout << \"No numbers were entered.\\n\";\r\n        return 1;\r\n    }\r\n\r\n    std::cout << \"\\n--- Compiler Vector & Loop Test ---\" << std::endl;\r\n    std::cout << \"Total elements stored: \" << numbers.size() << std::endl;\r\n\r\n    // Use a range-based for loop to print and sum the elements\r\n    int total_sum = 0;\r\n    std::cout << \"Numbers inside the vector: \";\r\n    for (int num : numbers) {\r\n        std::cout << num << \" \";\r\n        total_sum += num;\r\n    }\r\n    std::cout << std::endl;\r\n\r\n    // Output final calculation\r\n    std::cout << \"Sum of all elements: \" << total_sum << std::endl;\r\n    std::cout << \"------------------------------------\" << std::endl;\r\n    std::cout << \"Success: Vector and loops are working!\" << std::endl;\r\n\r\n    return 0;\r\n}\r\n",
      "outputs": [
        {
          "type": "stdout",
          "text": "Enter 2 or 3 integers (press Ctrl+D or type a non-number to finish):\nNo numbers were entered.\n",
          "diagnostics": []
        }
      ],
      "executionCount": 3,
