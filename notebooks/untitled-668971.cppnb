      "type": "code",
      "source": "#include <iostream>\r\n#include <vector>\r\n\r\nusing namespace std;\r\n\r\nint main() {\r\n    // Hardcoded vector with your test numbers (no user input needed)\r\n    vector<int> numbers = {2, 3};\r\n\r\n    cout << \"--- Hardcoded Loop Output Test ---\" << endl;\r\n\r\n    // The single output loop\r\n    int total_sum = 0;\r\n    for (int num : numbers) {\r\n        cout << \"Number: \" << num << endl;\r\n        total_sum += num;\r\n    }\r\n\r\n    cout << \"Total Sum: \" << total_sum << endl;\r\n    cout << \"----------------------------------\" << endl;\r\n    cout << \"Success: Loop executed perfectly without input!\" << endl;\r\n\r\n    return 0;\r\n}\r\n",
