    {
      "id": "cell-2e48e673-e076-476d-8b73-ba3848588395",
      "type": "code",
      "source": "#include <iostream>\r\n#include <vector> // Required for std::vector\r\n\r\nint main() {\r\n    std::vector<int> numbers;\r\n    int input;\r\n\r\n    std::cout << \"Enter numbers (type any letter to stop): \" << std::endl;\r\n\r\n    // Loop runs as long as the user enters valid integers\r\n    while (std::cin >> input) {\r\n        numbers.push_back(input); // Dynamically appends to the vector\r\n    }\r\n\r\n    // Displaying the vector elements using a modern range-based loop\r\n    std::cout << \"\\nYou entered: \";\r\n    for (int num : numbers) {\r\n        std::cout << num << \" \";\r\n    }\r\n\r\n    return 0;\r\n}\r\n",
      "outputs": [
        {
          "type": "stdout",
          "text": "Enter numbers (type any letter to stop): \n\nYou entered: 23 12 132 ",
          "diagnostics": []
        }
      ],
      "executionCount": 2,
      "status": "success",
      "executionTime": 1.1123
    },
    {
      "id": "cell-26fc25e1-636a-406f-8b00-8bea4239c616",
      "type": "code",
      "source": "#include <iostream>\r\n#include <vector>\r\n\r\nint main() {\r\n    int total_elements;\r\n    std::cout << \"How many numbers do you want to enter? \";\r\n    std::cin >> total_elements;\r\n\r\n    // Create a vector with a pre-defined size\r\n    std::vector<int> numbers(total_elements);\r\n\r\n    std::cout << \"Enter \" << total_elements << \" numbers:\" << std::endl;\r\n    \r\n    // Standard for loop to gather input by index\r\n    for (int i = 0; i < total_elements; i++) {\r\n        std::cout << \"Element \" << i + 1 << \": \";\r\n        std::cin >> numbers[i]; // Store directly into index\r\n    }\r\n\r\n    // Outputting data\r\n    std::cout << \"\\nYour vector contents: \";\r\n    for (int i = 0; i < numbers.size(); i++) {\r\n        std::cout << numbers[i] << \" \";\r\n    }\r\n\r\n    return 0;\r\n}\r\n",
